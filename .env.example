# .env.example — Bismark AI
#
# Copy this file to the appropriate local/server environment file
# and provide real values there.
#
# NEVER commit real credentials.
# NEVER place server-side secrets in NEXT_PUBLIC_* variables.
#
# This file documents the canonical environment variables expected
# by Bismark AI V1. Some variables are optional until the related
# roadmap phase is implemented.

# ============================================================
# APPLICATION
# ============================================================

APP_ENV=development
APP_NAME=Bismark AI
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Public-facing URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# Comma-separated allowed origins for backend CORS.
# Production example:
# CORS_ORIGINS=https://app.bismark.ai
CORS_ORIGINS=http://localhost:3000

# Number of trusted reverse proxies in front of FastAPI.
# Set deliberately in production.
TRUSTED_PROXY_COUNT=1


# ============================================================
# FRONTEND — NEXT.JS / VERCEL
# ============================================================

# Safe for browser exposure.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never add these as NEXT_PUBLIC_*:
# - SUPABASE_SERVICE_ROLE_KEY
# - DATABASE_URL
# - VOYAGE_API_KEY
# - LLM_API_KEY


# ============================================================
# SUPABASE
# ============================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connection string used by backend and migrations.
# Example format:
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Private object-storage bucket for uploaded source documents.
SUPABASE_STORAGE_BUCKET=bismark-documents

# Optional signed source URL lifetime.
SIGNED_URL_TTL_SECONDS=300


# ============================================================
# DATABASE / POSTGRESQL
# ============================================================

# Pool sizing should be tuned for the deployed environment.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# Enable only when explicitly required by the deployment environment.
DB_SSL_REQUIRE=true


# ============================================================
# AUTHENTICATION
# ============================================================

# Supabase JWT validation configuration.
# Values may be derived from Supabase project configuration.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Optional explicit JWKS URL if implementation uses it.
SUPABASE_JWKS_URL=


# ============================================================
# VOYAGE AI — EMBEDDINGS
# ============================================================

VOYAGE_API_KEY=

# Keep model name configurable.
VOYAGE_EMBEDDING_MODEL=

# Select and verify the embedding model before setting its dimension.
# Must match the vector dimension used by the database schema; no default is assumed.
VOYAGE_EMBEDDING_DIMENSION=

# Embedding batch size.
VOYAGE_EMBEDDING_BATCH_SIZE=32

# Provider request timeout.
VOYAGE_TIMEOUT_SECONDS=30

# Retry configuration.
VOYAGE_MAX_RETRIES=3


# ============================================================
# VOYAGE AI — RERANKING
# ============================================================

VOYAGE_RERANK_MODEL=

# Number of candidates sent to reranker can also be governed
# by the RAG_* variables below.
VOYAGE_RERANK_TIMEOUT_SECONDS=30
VOYAGE_RERANK_MAX_RETRIES=3


# ============================================================
# LLM PROVIDER
# ============================================================

# Example values:
# openai
# anthropic
# openrouter
# azure_openai
# other supported provider adapter
LLM_PROVIDER=

# Provider model identifier.
LLM_MODEL=

# Private provider credential.
LLM_API_KEY=

# Optional custom endpoint / compatible gateway.
LLM_BASE_URL=

# Generation controls.
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2


# ============================================================
# REDIS / BACKGROUND JOBS
# ============================================================

# Host-local backend (running directly on the developer machine):
# REDIS_URL=redis://localhost:6379/0
# Docker backend (inside the compose network):
REDIS_URL=redis://redis:6379/0

# Worker settings.
WORKER_CONCURRENCY=1
JOB_MAX_RETRIES=3
JOB_TIMEOUT_SECONDS=900
PARSER_TIMEOUT_SECONDS=600

# Optional worker identifier prefix.
WORKER_NAME=bismark-worker


# ============================================================
# DOCUMENT INGESTION
# ============================================================

MAX_UPLOAD_SIZE_MB=50

# Comma-separated MIME allowlist.
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,text/html

# Parser selection is open; do not select a default until evaluated.
# Expected initial values:
# docling
# unstructured
DOCUMENT_PARSER=

# Optional parser version pin for observability.
DOCUMENT_PARSER_VERSION=

# Temporary worker directory.
DOCUMENT_TEMP_DIR=/tmp/bismark

# Remove temporary files after job completion/failure.
DOCUMENT_TEMP_CLEANUP=true


# ============================================================
# CHUNKING
# ============================================================

RAG_CHUNK_TARGET_TOKENS=700
RAG_CHUNK_OVERLAP_TOKENS=80

# Optional hard maximum for a single chunk.
RAG_CHUNK_MAX_TOKENS=1000

# Whether structural headings should be injected into
# embedding text when available.
RAG_INCLUDE_HEADING_CONTEXT=true


# ============================================================
# RETRIEVAL
# ============================================================

RAG_VECTOR_CANDIDATES=30
RAG_KEYWORD_CANDIDATES=30
RAG_FUSED_CANDIDATES=30
RAG_RERANK_CANDIDATES=30
RAG_FINAL_EVIDENCE_COUNT=6

# Maximum approximate context budget supplied to the LLM.
RAG_MAX_CONTEXT_TOKENS=12000

# Number of recent conversation turns considered.
RAG_CONVERSATION_TURNS=6

# Optional threshold. Leave blank until calibrated.
RAG_MIN_RERANK_SCORE=

# Initial fusion strategy.
RAG_FUSION_STRATEGY=rrf

# Reciprocal Rank Fusion constant.
RAG_RRF_K=60


# ============================================================
# CHAT / STREAMING
# ============================================================

# Server-Sent Events is the intended V1 streaming transport.
CHAT_STREAM_TRANSPORT=sse

# Optional maximum user message length.
CHAT_MAX_MESSAGE_CHARS=12000

# Maximum assistant generation duration.
CHAT_GENERATION_TIMEOUT_SECONDS=120


# ============================================================
# RATE LIMITING
# ============================================================

# These are starting placeholders and must be tuned.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=50
RATE_LIMIT_INVITES_PER_HOUR=20

# Optional generic request limit.
RATE_LIMIT_API_PER_MINUTE=120


# ============================================================
# LOGGING / OBSERVABILITY
# ============================================================

LOG_FORMAT=json

# Do not enable full prompt/document logging in production.
LOG_REQUEST_BODIES=false
LOG_LLM_PROMPTS=false
LOG_RETRIEVED_CONTENT=false

# Optional external observability integrations may be added later.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=


# ============================================================
# AUDIT / USAGE
# ============================================================

AUDIT_LOG_ENABLED=true
USAGE_TRACKING_ENABLED=true


# ============================================================
# SECURITY
# ============================================================

# Development should normally be false; production should be true.
FORCE_HTTPS=false

# Strict Transport Security.
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000

# Upload/content safety.
ALLOW_PUBLIC_DOCUMENTS=false

# Whether source URLs must always be short-lived signed URLs.
REQUIRE_SIGNED_SOURCE_URLS=true


# ============================================================
# CADDY / DEPLOYMENT
# ============================================================

# Used by deployment tooling / Compose templates.
API_DOMAIN=api.bismark.ai
FRONTEND_DOMAIN=app.bismark.ai

# Image/version tag used by Docker Compose deployments.
APP_IMAGE=
APP_IMAGE_TAG=latest

# Optional container registry.
CONTAINER_REGISTRY=


# ============================================================
# CI / CD
# ============================================================

# CI providers should inject secrets through their secret store.
CI=false

# Optional Git commit SHA surfaced in /version.
GIT_SHA=


# ============================================================
# TESTING
# ============================================================

TESTING=false

# Separate test database strongly recommended.
TEST_DATABASE_URL=

# Separate Redis database or instance for tests.
TEST_REDIS_URL=redis://localhost:6379/1

# Use fake providers by default in unit/integration tests.
USE_FAKE_EMBEDDING_PROVIDER=true
USE_FAKE_RERANK_PROVIDER=true
USE_FAKE_LLM_PROVIDER=true

# Explicit opt-in for live provider integration tests.
RUN_LIVE_PROVIDER_TESTS=false


# ============================================================
# STAGING / PRODUCTION NOTES
# ============================================================

# In production:
#
# APP_ENV=production
# FORCE_HTTPS=true
# CORS_ORIGINS=https://app.bismark.ai
#
# Do NOT use placeholder secrets.
# Do NOT expose Redis publicly.
# Do NOT use the Supabase service-role key in the browser.
# Do NOT commit production environment files.
